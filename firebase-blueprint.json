{
  "entities": {
    "Interaction": {
      "title": "Interaction",
      "description": "User journal entry and reflection interaction with optional location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "mode": { "type": "string", "enum": ["reflection", "brainstorm", "deep_thinking", "gratitude"] },
        "messages": { "type": "array" },
        "tags": { "type": "array" },
        "summary": { "type": "string", "maxLength": 5000 },
        "isPinned": { "type": "boolean" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 },
            "placeName": { "type": "string", "maxLength": 256 }
          },
          "required": ["lat", "lng", "placeName"]
        },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "mode", "messages", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/Interaction" },
      "description": "User-isolated journal entries and reflection history"
    }
  }
}
