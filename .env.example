# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-app-url.run.app"

# VITE_GOOGLE_MAPS_API_KEY: Client-side Google Maps JavaScript & Places API key.
# Restrict this key in Google Cloud Console by HTTP Referrer (websites) and API scopes (Maps JavaScript API + Places API New).
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# SLACK_WEBHOOK_URL: Secret Manager secret containing the incoming webhook URL for Slack notifications.
# Server-side only (never exposed to client). Must begin with https://hooks.slack.com/services/.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# DIGEST_AUDIENCE: The exact URL Cloud Scheduler calls, e.g.
# https://<service>-<hash>-<region>.a.run.app/api/digest/weekly
# The digest route rejects any OIDC token whose `aud` claim is not this string.
DIGEST_AUDIENCE="https://your-app-url.run.app/api/digest/weekly"

# DIGEST_INVOKER_SA: Comma-separated allowlist of service-account emails permitted
# to trigger the weekly digest. Leave unset and the route refuses every caller.
DIGEST_INVOKER_SA="journal-digest-scheduler@YOUR_PROJECT.iam.gserviceaccount.com"
